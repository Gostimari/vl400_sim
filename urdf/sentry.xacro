<robot name="sentry" xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:arg name="gpu" default="true"/>
    <xacro:property name="gpu" value="$(arg gpu)" />
    <xacro:arg name="organize_cloud" default="false"/>
    <xacro:property name="organize_cloud" value="$(arg organize_cloud)" />

    <!-- ######### SENTRY link ######### -->
    <link name="sentry_link">
      <!-- Sensor mast, ~3 kg; CoM at the mesh AABB center, inertia of
           the 0.545 x 0.637 x 0.599 m box. -->
      <inertial>
        <origin xyz="0.272 0.318 0.411"/>
        <mass value="3"/>
        <inertia ixx="0.191" ixy="0" ixz="0" iyy="0.164" iyz="0" izz="0.176"/>
      </inertial>
      <visual>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <geometry>
             <mesh filename="package://vl400_sim/meshes/Sentry.STL" scale="0.0012 0.0012 0.0012"/>
          </geometry>
          <material name="silver">
            <color rgba="0.75 0.75 0.75 1"/>
          </material>
        </visual>
      <!-- Box proxy matching the mesh AABB (0.55 x 0.64 x 0.60 m).
           Mesh collisions on the robot trigger the ODE trimesh-trimesh
           path against the terrain mesh (grind + crash); see the note
           on tool_link in vl400.xacro. -->
      <collision>
        <origin rpy="0 0 0" xyz="0.272 0.318 0.411"/>
        <geometry>
          <box size="0.545 0.637 0.599"/>
        </geometry>
      </collision>
    </link>

    <joint name="sentry_joint" type="fixed">
     <origin rpy="1.5707 0 0" xyz="${-wheel_radius-0.5} 0.4 ${base_z_size/2}"/>
     <parent link="chassis_link"/>
     <child link="sentry_link"/>
    </joint>

    <gazebo reference="sentry_link">
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
    </gazebo>

    <!--#########   DURO LINK (IMU) #########-->
      <link name="imu_link">
        <inertial>
          <mass value="0.01"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <box size="0.130 0.130 0.06"/>
          </geometry>
          <material name="yellow">
            <color rgba="0.9 0.9 0.0 1"/>
          </material>
        </visual>
      </link>

      <joint name="joint_imu" type="fixed">
        <origin xyz="0.27 0.40 0.41" rpy="-1.5707 0 0"/>
        <parent link="sentry_link"/>
        <child link="imu_link"/>
      </joint>

      <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/imu</topic>
          <gz_frame_id>imu_link</gz_frame_id>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-3</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>

        <sensor name="mag_sensor" type="magnetometer">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/mag</topic>
          <gz_frame_id>imu_link</gz_frame_id>
        </sensor>
      </gazebo>

      <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
      </gazebo>

      <gazebo>
        <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
      </gazebo>

    <!--######### GPS SENSOR #########-->
      <link name="gps_link">
        <inertial>
          <mass value="0.01"/>
          <origin xyz="0 0 0"/>
          <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.065" length="0.05"/>
          </geometry>
          <material name="yellow">
            <color rgba="0.9 0.9 0.0 1"/>
          </material>
        </visual>
      </link>

      <joint name="joint_gps" type="fixed">
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
        <parent link="imu_link"/>
        <child link="gps_link"/>
      </joint>

        <gazebo reference="gps_link">
            <sensor name="gps_sensor" type="navsat">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <topic>/fix</topic>
                <gz_frame_id>gps_link</gz_frame_id>
            </sensor>
        </gazebo>

        <gazebo>
            <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
        </gazebo>

    <!--######### LiDAR Sensors (Velodyni, livox HAP) #########-->
    <gazebo reference="velodyne_base_link">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>

    <!-- Velodyne VLP-16 -->
    <!-- <xacro:include filename="$(find vl400_sim)/urdf/velodyne_vlp16.urdf.xacro"/>
        <xacro:VLP-16 parent="sentry_link" name="velodyne" topic="/velodyne_points" organize_cloud="${organize_cloud}" hz="10" samples="440" gpu="${gpu}">
        <origin xyz="0.47 0.42 0.41" rpy="-1.5707 0 0" />
    </xacro:VLP-16> -->

    <!-- Livox HAP -->
    <xacro:include filename="$(find vl400_sim)/urdf/livox_hap.xacro"/>
    <xacro:livox_hap parent="sentry_link" name="livox_hap" topic="/livox_hap" ros_topic="/livox/lidar/pointcloud2" frame_id="livox_hap_link">
      <origin xyz="0.45 0.33 0.41" rpy="-1.5707 0 0"/>
    </xacro:livox_hap>

    <!-- Zed 2i Camera -->
    <xacro:include filename="$(find vl400_sim)/urdf/zed2i_camera.xacro"/>

</robot>
