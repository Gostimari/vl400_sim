<?xml version="1.0" ?>
<sdf version="1.6">
  <!--
    Ground fog generator (gz-sim particle emitters).

    A single box emitter always spawns its particles in a vertical
    column and ignores <size>, so the fog is built as a grid of 25
    slow point emitters spread over a ~15x15 m area. Each one emits
    large soft puffs that drift up at 0.05-0.15 m/s, so together they
    read as a wide fog bank hugging the ground (~2 m high).

    Density: raise <rate> (puffs per second per emitter) or
    <particle_size> (m). Extent: move/scale the fog_puff_* link
    poses.
  -->
  <model name="fog_generator">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="fog_puff_0">
      <pose>-7.2 -7.2 0.15 0 0 0</pose>
      <gravity>0</gravity>
      <particle_emitter name="emitter_0" type="point">
        <emitting>true</emitting>
        <particle_size>2.5 2.5 2.5</particle_size>
        <lifetime>25</lifetime>
        <min_velocity>0.05</min_velocity>
        <max_velocity>0.15</max_velocity>
        <scale_rate>0.1</scale_rate>
        <rate>50</rate>
        <material>
          <diffuse>0.75 0.75 0.75</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr><metal><albedo_map>materials/textures/fog.png</albedo_map></metal></pbr>
        </material>
        <color_range_image>materials/textures/fogcolors.png</color_range_image>
      </particle_emitter>
    </link>
    <link name="fog_puff_1">
      <pose>-7.2 -3.6 0.60 0 0 0</pose>
      <gravity>0</gravity>
      <particle_emitter name="emitter_1" type="point">
