<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
    <world name="forest_ground-50-easy">
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
        <!-- Sensors system: required for all gz-sim sensors (lidars, IMU,
             GPS, ...). Without it no sensor publishes anything. -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <!-- 500 Hz / 2 ms: halves the physics and per-iteration system cost
             (and the /joint_states + /clock rates) with negligible
             fidelity loss for this robot. type=dart is the engine gz-sim
             already falls back to; it is stated explicitly so this block
             is actually parsed. -->
        <physics name="2ms" type="dart">
            <max_step_size>0.002</max_step_size>
            <real_time_update_rate>500</real_time_update_rate>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <gravity>0 0 -9.8</gravity>
        <!-- Reference for the navsat (GPS) sensor: lat/lon/alt of the
             world origin. The world frame is ENU (+x east, +y north),
             so the robot's world position maps to small local offsets.
             49.9 / 8.9 matches ORIGIN_LAT / ORIGIN_LON in
             scripts/pub_GPS_XY_trator.py, which converts /fix into
             local XY metres. Without this block the fix would report
             lat/lon near 0/0. -->
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>49.9</latitude_deg>
            <longitude_deg>8.9</longitude_deg>
            <elevation>0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>
        <!-- Earth-like magnetic field in Tesla (sdformat default) for
             the magnetometer: mostly horizontal, pointing ~north. -->
        <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>
        <light name="sun" type="directional">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.8 0.9 1</background>
        </scene>
        <light name="ambient" type="directional">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <direction>0.1 0.1 -0.9</direction>
        </light>
        <light name="point_light" type="point">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 15 0 0 0</pose>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <attenuation>
                <range>50</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>
        <include>
            <uri>model://ground-50-easy</uri>
            <name>terrain</name>
            <pose>0 0 0 0 0 0</pose>
        </include>
        <include>
            <uri>model://tree/tree</uri>
            <name>tree_0</name>
            <pose>6.4339 12.5563 2.4400 -0.0474 0.0002 3.2359</pose>
            <scale>1.402 1.402 1.402</scale>
        </include>
